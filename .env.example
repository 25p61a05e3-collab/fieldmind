# FieldMind server configuration
# Keep these values server-side. Never prefix private keys with VITE_.

# MongoDB Atlas structured records
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=fieldmind

# Hindsight Cloud persistent memory
# Use the Hindsight Cloud/API base URL supplied by your Hindsight workspace.
HINDSIGHT_BASE_URL=https://<your-hindsight-api-host>
HINDSIGHT_API_KEY=<your-hindsight-api-key>
HINDSIGHT_BANK_ID=fieldmind
HINDSIGHT_TIMEOUT_MS=12000

# Groq server-side LLM reasoning
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=18000

# Optional split deployment: set this only if Netlify serves the frontend separately.
# VITE_API_BASE_URL=https://<your-render-backend>
# FRONTEND_ORIGIN=https://<your-netlify-site>.netlify.app
